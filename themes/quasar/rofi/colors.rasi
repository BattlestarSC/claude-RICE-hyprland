/* Quasar palette as rasi variables. Used by orbit.rasi and deck.rasi via @import. */
* {
    crust:    #0F0E14;
    mantle:   #14131A;
    base:     #191820;
    surface0: #23212C;
    surface1: #2C2B38;
    surface2: #3F3D50;
    overlay:  #9D99AD;
    subtext:  #BAB6C6;
    text:     #E4E0E9;
    bright:   #F3F1F6;

    red:      #FD8DA8;
    orange:   #F69C56;
    yellow:   #DCCD77;
    green:    #A6DA64;
    cyan:     #78D3E3;
    blue:     #88AFFD;
    purple:   #BEA0FE;
