# Generated by tools/render_theme.py from colors/quasar.toml. Do not edit; edit the template.
# Quasar for Zathura (PDF viewer). Deployed to ~/.config/zathura/zathurarc; add your own
# settings in ~/.config/zathura/local (included at the end, created empty by the installer).
# Option names: zathura zathura/config.c (girara UI options are registered there too).
# Pages stay as the document draws them (white); Ctrl+R recolors them into the palette.
# Docs: docs/knowledge-base/apps.md#zathura

set font                     "JetBrains Mono 11"
set selection-clipboard      clipboard
set window-title-basename    true
set statusbar-home-tilde     true
set adjust-open              "best-fit"
set synctex                  true

set default-bg               "#191820"
set default-fg               "#E4E0E9"
set statusbar-bg             "#14131A"
set statusbar-fg             "#BAB6C6"
set inputbar-bg              "#0F0E14"
set inputbar-fg              "#E4E0E9"
set notification-bg          "#23212C"
set notification-fg          "#E4E0E9"
set notification-warning-bg  "#DCCD77"
set notification-warning-fg  "#0F0E14"
set notification-error-bg    "#FD8DA8"
set notification-error-fg    "#0F0E14"
set completion-bg            "#14131A"
set completion-fg            "#E4E0E9"
set completion-group-bg      "#0F0E14"
set completion-group-fg      "#BEA0FE"
set completion-highlight-bg  "#BEA0FE"
set completion-highlight-fg  "#0F0E14"
set index-bg                 "#191820"
set index-fg                 "#E4E0E9"
set index-active-bg          "#2C2B38"
set index-active-fg          "#F3F1F6"
set scrollbar-bg             "#14131A"
set scrollbar-fg             "#3F3D50"
set render-loading-bg        "#191820"
set render-loading-fg        "#9D99AD"
set highlight-color          "rgba(220, 205, 119, 0.35)"
set highlight-fg             "#0F0E14"
set highlight-active-color   "rgba(190, 160, 254, 0.5)"
set signature-success-color  "rgba(166, 218, 100, 0.35)"
set signature-warning-color  "rgba(220, 205, 119, 0.35)"
set signature-error-color    "rgba(253, 141, 168, 0.35)"

# Ctrl+R: the page background becomes the palette's base, text its text color.
set recolor-lightcolor       "#191820"
set recolor-darkcolor        "#E4E0E9"
set recolor-keephue          true

include local
