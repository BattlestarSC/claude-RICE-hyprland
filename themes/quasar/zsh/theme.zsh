# ---- zsh-autosuggestions: the grey "ghost" completion after the cursor ----
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#9D99AD'

# ---- zsh-history-substring-search (Up/Down search history for what you typed) ----
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=#3F3D50,fg=#F3F1F6,bold'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='bg=#FD8DA8,fg=#0F0E14,bold'

# ---- Completion menu (zsh/complist), used by completion.zsh ----
# Selected entry: purple bar with dark text, the same selection as rofi and the bar.
RICE_COMPLETION_SELECTED='ma=48;2;190;160;254;38;2;15;14;20;1'
RICE_COMPLETION_HEADER='%F{#BEA0FE}%B%d%b%f'
RICE_COMPLETION_MESSAGE='%F{#9D99AD}%d%f'
RICE_COMPLETION_WARNING='%F{#FD8DA8}no matches for %d%f'
RICE_COMPLETION_SCROLL='%K{#2C2B38}%F{#E4E0E9} %m of %M · %p · scroll with arrows, type Ctrl+S to search %f%k'

# ---- fzf (Ctrl+R history, Ctrl+T files, Alt+C directories) ----
export FZF_DEFAULT_OPTS="--color=fg:#E4E0E9,bg:#191820,hl:#FD8DA8,fg+:#F3F1F6,bg+:#2C2B38,hl+:#FD8DA8\
 --color=info:#BEA0FE,prompt:#BEA0FE,pointer:#FB89CD,marker:#A6DA64,spinner:#FB89CD,header:#78D3E3,border:#3F3D50\
 --border=rounded --layout=reverse --height=40% --info=inline-right"
