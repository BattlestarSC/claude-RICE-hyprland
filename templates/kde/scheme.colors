# {{ name }} as a KDE color scheme: Dolphin and other KDE/Qt apps (via hyprqt6engine's
# theme:color_scheme). Deployed to ~/.local/share/color-schemes/{{ name }}.colors.
# Structure follows Breeze Dark (KDE/breeze colors/BreezeDark.colors).

[ColorEffects:Disabled]
Color={{ surface1 | rgbcsv }}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ surface2 | rgbcsv }}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Window]
BackgroundAlternate={{ base | rgbcsv }}
BackgroundNormal={{ mantle | rgbcsv }}
DecorationFocus={{ purple | rgbcsv }}
DecorationHover={{ red | rgbcsv }}
ForegroundActive={{ purple | rgbcsv }}
ForegroundInactive={{ overlay | rgbcsv }}
ForegroundLink={{ blue | rgbcsv }}
ForegroundNegative={{ red | rgbcsv }}
ForegroundNeutral={{ yellow | rgbcsv }}
ForegroundNormal={{ text | rgbcsv }}
ForegroundPositive={{ green | rgbcsv }}
ForegroundVisited={{ purple | rgbcsv }}

[Colors:View]
BackgroundAlternate={{ mantle | rgbcsv }}
BackgroundNormal={{ base | rgbcsv }}
DecorationFocus={{ purple | rgbcsv }}
