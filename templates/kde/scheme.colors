BackgroundNormal={{ purple | rgbcsv }}
DecorationFocus={{ purple | rgbcsv }}
DecorationHover={{ red | rgbcsv }}
ForegroundActive={{ crust | rgbcsv }}
ForegroundInactive={{ surface1 | rgbcsv }}
ForegroundLink={{ crust | rgbcsv }}
ForegroundNegative={{ crust | rgbcsv }}
ForegroundNeutral={{ crust | rgbcsv }}
ForegroundNormal={{ crust | rgbcsv }}
ForegroundPositive={{ crust | rgbcsv }}
ForegroundVisited={{ crust | rgbcsv }}

[Colors:Tooltip]
BackgroundAlternate={{ mantle | rgbcsv }}
BackgroundNormal={{ surface0 | rgbcsv }}
DecorationFocus={{ purple | rgbcsv }}
DecorationHover={{ red | rgbcsv }}
ForegroundActive={{ purple | rgbcsv }}
ForegroundInactive={{ overlay | rgbcsv }}
