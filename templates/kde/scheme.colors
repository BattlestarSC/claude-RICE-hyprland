[General]
ColorScheme={{ name }}
Name={{ name }}
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{ mantle | rgbcsv }}
activeBlend={{ text | rgbcsv }}
activeForeground={{ text | rgbcsv }}
inactiveBackground={{ crust | rgbcsv }}
inactiveBlend={{ overlay | rgbcsv }}
inactiveForeground={{ overlay | rgbcsv }}
