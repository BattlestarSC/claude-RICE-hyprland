/*
 * Flight Deck: the theme for every scripted menu (rofi -dmenu): session, clipboard,
 * quick toggles, monitors, screenshots. Mono, gradient frame, hard offset shadow,
 * prompt as a tag, key hints in a status line.
 *
 * The shadow is layout, not an effect: the frame sits in a row with a shadow column
 * that starts SHADOW px lower, above a shadow row that starts SHADOW px further right.
 */
@import "colors.rasi"

/* Orbit sets eh: 2 for its two-line rows; menus are one line. */
configuration { eh: 1; }

* {
    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @text;
}

window {
    location:         center;
    width:            560px;
    border:           0;
    padding:          0;
    background-color: transparent;
    transparency:     "real";
}

mainbox      { children: [ frame-row, shadow-row ]; spacing: 0; }
frame-row    { orientation: horizontal; children: [ frame, shadow-col ]; spacing: 0; }
shadow-col   { orientation: vertical; children: [ shadow-gap, shadow-right ]; expand: false; spacing: 0; }
shadow-gap   { expand: false; padding: 4px 4px 5px 5px; }
shadow-right { expand: true; padding: 0 4px 0 5px; background-color: @deck-shadow; }
shadow-row   { orientation: horizontal; children: [ shadow-pad, shadow-bottom ]; expand: false; spacing: 0; }
shadow-pad   { expand: false; padding: 4px 4px 5px 5px; }
shadow-bottom{ expand: true; padding: 4px 0 5px 0; background-color: @deck-shadow; }

frame {
    padding:          2px;
    border-radius:    4px;
    background-image: linear-gradient(to right, {{ red }}, {{ purple }});
    children:         [ body ];
}
body {
    children:         [ inputbar, message, listview, textbox-hints ];
    spacing:          0;
    border-radius:    3px;
    background-color: @mantle;
}

inputbar {
    children:     [ prompt, textbox-chevron, entry ];
    spacing:      10px;
    padding:      10px 14px;
    border:       0 0 1px 0;
    border-color: @surface2;
}
prompt          { padding: 1px 10px; background-color: @red; text-color: @crust; }
textbox-chevron { content: "❯"; expand: false; text-color: @red; vertical-align: 0.5; }
entry           { placeholder: ""; cursor-color: @yellow; vertical-align: 0.5; }

message  { padding: 6px 14px; border: 0 0 1px 0; border-color: @surface2; }
textbox  { text-color: @subtext; }

listview { lines: 8; fixed-height: false; scrollbar: false; spacing: 0; padding: 6px 8px; }
element  { padding: 4px 8px; spacing: 10px; border: 0 0 0 3px; border-color: transparent; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @deck-sel; border-color: @red; }
element-text { text-color: inherit; highlight: bold {{ yellow }}; }
element selected.normal element-text { text-color: @bright; }
element normal.active element-text   { text-color: @green; }

textbox-hints {
    content:      "↵ select    esc abort";
    expand:       false;
    padding:      6px 14px;
    border:       1px 0 0 0;
    border-color: @surface2;
    text-color:   @overlay;
}
