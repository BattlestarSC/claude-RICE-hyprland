# {{ name }} notifications for the i3 session (dunst; the Hyprland session uses Quickshell's).
# Installed as ~/.config/dunst/dunstrc. Look follows the Quickshell popups: dark glass card,
# 12 px radius, a surface2 hairline, accent by urgency; picom blurs behind it. Keys: dunst(5).
[global]
    monitor = 0
    follow = mouse
    width = (300, 420)
    height = (0, 300)
    origin = top-right
    offset = (12, 52)
    notification_limit = 5
    progress_bar = true
    progress_bar_frame_width = 0
    indicate_hidden = true
    transparency = 0
    separator_height = 1
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    gap_size = 6
    separator_color = frame
    sort = urgency_descending
    font = IBM Plex Sans 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = true
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = true
    history_length = 30
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 12
    corners = all
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "{{ mantle | hexa:0.88 }}"
    foreground = "{{ subtext }}"
    frame_color = "{{ surface2 }}"
    highlight = "{{ cyan }}"
    timeout = 6

[urgency_normal]
    background = "{{ mantle | hexa:0.90 }}"
    foreground = "{{ text }}"
    frame_color = "{{ surface2 }}"
    highlight = "{{ purple }}"
    timeout = 8

[urgency_critical]
    background = "{{ mantle | hexa:0.95 }}"
    foreground = "{{ bright }}"
    frame_color = "{{ red }}"
    highlight = "{{ red }}"
    timeout = 0
