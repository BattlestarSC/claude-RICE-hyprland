#!/usr/bin/env bash
# rice-browser-setup: apply the rice's browser prefs and palette to every existing profile of
# Firefox and LibreWolf. Safe to re-run; runs as your user, never as root.
#
#   rice-browser-setup [SOURCE_DIR]      default: ~/.local/share/rice/browsers
#
# SOURCE_DIR holds what the installer deploys:
#   user.js                    privacy + appearance prefs (Firefox)
#   librewolf.overrides.cfg    LibreWolf appearance prefs
#   chrome/userChrome.css      palette for the browser UI (Firefox, LibreWolf)
#   chrome/userContent.css     palette for blank/new-tab pages
#
# What it changes, per profile (profiles are read from each browser's profiles.ini):
#   user.js                 only the block between the "rice" markers; the rest is yours
#   chrome/user*.css        replaced; a file that is not ours is first kept as *.rice-bak
#   ~/.librewolf/librewolf.overrides.cfg   only the block between the markers
# A browser that has never been started has no profile yet: start it once, then re-run this.
# System-wide policies (NoScript, uBlock Origin, telemetry locks) are a separate, root-owned
# step done by the installer; see docs/knowledge-base/browsers.md.
set -Eeuo pipefail

readonly BEGIN_MARK="// >>> rice: managed by rice-browser-setup, edits inside are overwritten"
readonly END_MARK="// <<< rice"
readonly CSS_MARK="Generated by tools/render_theme.py"

src="${1:-${HOME}/.local/share/rice/browsers}"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
changed=0

die() { printf 'rice-browser-setup: %s\n' "$*" >&2; exit 1; }
say() { printf '  %s\n' "$*"; }

# Replace (or append) the marked block in FILE with the contents of BLOCK_FILE.
write_block() {
    local file="$1" block_file="$2" tmp
    tmp="$(mktemp)"
    if [[ -f "${file}" ]]; then
        # Keep the user's original once (a file that never had our block).
        if [[ ! -f "${file}.rice-bak" ]] && ! grep -qxF "${BEGIN_MARK}" -- "${file}"; then
            cp -p -- "${file}" "${file}.rice-bak"
        fi
        awk -v b="${BEGIN_MARK}" -v e="${END_MARK}" '
            $0 == b { skip = 1; next }
            $0 == e { skip = 0; next }
            !skip' "${file}" > "${tmp}"
    fi
    {
        printf '%s\n' "${BEGIN_MARK}"
        cat -- "${block_file}"
        printf '%s\n' "${END_MARK}"
    } >> "${tmp}"
    mv -- "${tmp}" "${file}"
}

# Copy a generated CSS file into a profile's chrome/, keeping a foreign file as *.rice-bak.
install_css() {
    local from="$1" to="$2"
    mkdir -p -- "$(dirname -- "${to}")"
    if [[ -f "${to}" ]] && ! grep -qF "${CSS_MARK}" -- "${to}"; then
        cp -p -- "${to}" "${to}.rice-bak"
    fi
    cp -- "${from}" "${to}"
}

# Print the absolute path of every profile listed in BASE/profiles.ini that exists.
profiles_in() {
    local base="$1" ini="$1/profiles.ini" line path="" relative=1
    [[ -f "${ini}" ]] || return 0
    while IFS= read -r line || [[ -n "${line}" ]]; do
        case "${line}" in
            \[*)
                if [[ -n "${path}" ]]; then
                    if (( relative )); then printf '%s\n' "${base}/${path}"; else printf '%s\n' "${path}"; fi
                fi
                path=""; relative=1 ;;
            Path=*) path="${line#Path=}" ;;
            IsRelative=0) relative=0 ;;
        esac
    done < "${ini}"
    if [[ -n "${path}" ]]; then
        if (( relative )); then printf '%s\n' "${base}/${path}"; else printf '%s\n' "${path}"; fi
    fi
}

# apply NAME PREFS_FILE(or "") WITH_CSS(0/1) BASE...
apply() {
    local name="$1" prefs="$2" with_css="$3"; shift 3
    local base profile found=0
    for base in "$@"; do
        while IFS= read -r profile; do
            [[ -d "${profile}" ]] || continue
            found=1
            if [[ -n "${prefs}" ]]; then write_block "${profile}/user.js" "${prefs}"; fi
            if (( with_css )); then
                install_css "${src}/chrome/userChrome.css" "${profile}/chrome/userChrome.css"
                install_css "${src}/chrome/userContent.css" "${profile}/chrome/userContent.css"
            fi
            say "${name}: ${profile}"
            changed=$((changed + 1))
        done < <(profiles_in "${base}")
    done
    if (( ! found )) && command -v "${name}" > /dev/null; then
        say "${name}: no profile yet; start ${name} once, close it, and run rice-browser-setup again"
    fi
}

main() {
    (( EUID != 0 )) || die "run as your user, not root"
    local f
    for f in user.js librewolf.overrides.cfg chrome/userChrome.css chrome/userContent.css; do
        [[ -f "${src}/${f}" ]] || die "missing ${src}/${f} (run the installer, or pass the source dir)"
    done

    printf 'Applying rice browser settings from %s\n' "${src}"
    # Firefox keeps ~/.mozilla/firefox when it exists, else uses $XDG_CONFIG_HOME/mozilla/firefox.
    apply firefox "${src}/user.js" 1 "${HOME}/.mozilla/firefox" "${config_home}/mozilla/firefox"
    # LibreWolf: prefs come from its overrides file, not user.js (LibreWolf's own hardening stays).
    apply librewolf "" 1 "${HOME}/.librewolf" "${config_home}/librewolf/librewolf" "${config_home}/librewolf"
    if command -v librewolf > /dev/null || [[ -d "${HOME}/.librewolf" ]]; then
        mkdir -p -- "${HOME}/.librewolf"
        write_block "${HOME}/.librewolf/librewolf.overrides.cfg" "${src}/librewolf.overrides.cfg"
        say "librewolf: ${HOME}/.librewolf/librewolf.overrides.cfg"
    fi

    printf 'Done: %d profile(s). Restart the browsers to apply.\n' "${changed}"
}

main "$@"
