#!/usr/bin/env bash
# Session plumbing that systemd does elsewhere, for systems without a systemd user manager
# (Gentoo with OpenRC, FreeBSD). Docs: docs/knowledge-base/platforms.md#sessions-without-systemd.
#
#   rice-session start                       polkit agent and PipeWire (autostart.lua, once)
#   rice-session power suspend|reboot|poweroff
#   rice-session hyprland                    start Hyprland from a console login (session.zsh)
#   rice-session lock                        lock the session (hypridle, Super+Shift+X, menu)
#   rice-session i3                          the X11 session: env, session bus, i3 (LightDM's
#                                            "Rice (i3)" entry runs this; FreeBSD's default)
#   rice-session x11                         the i3 session's helpers, once (i3 config: exec)
#
# With systemd, autostart.lua starts the polkit agent through `systemctl --user` and never calls
# `start`; `power` then uses systemctl. elogind (Gentoo/OpenRC) provides the same verbs through
# loginctl. FreeBSD has neither: shutdown(8) (group operator) and acpiconf(8).
set -Eeuo pipefail

notify() {
  if command -v notify-send >/dev/null; then notify-send -a rice-session "$@"; fi
}

running() { pgrep -u "$(id -u)" -x "$1" >/dev/null 2>&1; }

# detach CMD...: run CMD in its own session, output discarded. setsid(1) is util-linux; FreeBSD
# has daemon(8) (-f: stdio to /dev/null) instead (found by the FreeBSD CI: nothing started).
detach() {
  if command -v setsid >/dev/null; then
    setsid -f "$@" >/dev/null 2>&1
  elif command -v daemon >/dev/null; then
    daemon -f "$@"
  else
    nohup "$@" >/dev/null 2>&1 &
  fi
}

start_polkit_agent() {
  # D-Bus activation: hyprpolkitagent installs org.hyprland.hyprpolkitagent.service, whose Exec=
  # the session bus runs when there is no systemd to hand it to.
  gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.StartServiceByName org.hyprland.hyprpolkitagent 0 >/dev/null 2>&1 ||
    notify "Polkit agent" "could not start hyprpolkitagent; password prompts will not appear"
}

start_pipewire() {
  running pipewire && return 0
  if command -v gentoo-pipewire-launcher >/dev/null; then
    # Gentoo's launcher starts pipewire, wireplumber and pipewire-pulse and restarts them together.
    detach gentoo-pipewire-launcher restart
    return 0
  fi
  detach pipewire
  sleep 0.5
  running wireplumber || detach wireplumber
  running pipewire-pulse || detach pipewire-pulse
  return 0
}

power() {
  local action=$1
  case $action in suspend|reboot|poweroff) ;; *) echo "rice-session: unknown action '$action'" >&2; exit 2 ;; esac
  if [[ -d /run/systemd/system ]]; then
    exec systemctl "$action"
  elif command -v loginctl >/dev/null; then
    exec loginctl "$action"
  elif [[ $(uname -s) == FreeBSD ]]; then
    case $action in
      reboot)   exec shutdown -r now ;;
      poweroff) exec shutdown -p now ;;
      suspend)  # Nothing locks before sleep here (no logind for hypridle/xss-lock to hear).
                detach "$0" lock; sleep 1
                acpiconf -s 3 2>/dev/null || notify "Suspend" "acpiconf -s 3 needs root on FreeBSD" ;;
    esac
  else
    notify "Power" "neither systemctl nor loginctl is available"
    exit 1
  fi
}

# Hyprland from a console login: what a login manager would provide first. XDG_RUNTIME_DIR comes
# from logind/elogind or FreeBSD's pam_xdg; if nothing set it, a private directory stands in.
# The session bus is started here unless one exists (dbus-run-session ends it with Hyprland).
hyprland() {
  if [[ -z ${XDG_RUNTIME_DIR:-} || ! -d ${XDG_RUNTIME_DIR} ]]; then
    XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/runtime-$(id -u)"
    [[ -d $XDG_RUNTIME_DIR ]] || mkdir -m 0700 -- "$XDG_RUNTIME_DIR"
    [[ -O $XDG_RUNTIME_DIR ]] || { echo "rice-session: $XDG_RUNTIME_DIR is not yours" >&2; exit 1; }
    export XDG_RUNTIME_DIR
  fi
  export XDG_SESSION_TYPE=wayland
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    exec start-hyprland
  fi
  exec dbus-run-session start-hyprland
}

# logind/elogind: ask it to lock, so hypridle's lock_cmd runs and its lock state stays right.
# Without one (FreeBSD), start hyprlock directly, once. X11 (i3): i3lock, see lock_x11.
lock() {
  if [[ -z ${WAYLAND_DISPLAY:-} && -n ${DISPLAY:-} ]]; then
    lock_x11
    return
  fi
  if command -v loginctl >/dev/null && loginctl lock-session 2>/dev/null; then
    return 0
  fi
  pgrep -u "$(id -u)" -x hyprlock >/dev/null || exec hyprlock
}

# i3lock in the foreground (-n: xss-lock waits for it), once. i3lock-color draws the hyprlock
# look (palette ring and clock, ~/.config/i3/lock.sh) on the ASCII sky still; plain i3lock
# takes none of those options and would exit at once, leaving the screen unlocked, so it gets
# only the image. -e: an empty password is not tried; -f: show failed attempts.
lock_x11() {
  pgrep -u "$(id -u)" -x i3lock >/dev/null && return 0
  local image="${XDG_DATA_HOME:-$HOME/.local/share}/rice/lock.png" args=(-n -e -f)
  # i3lock-color's version reads "2.13.c.5 ... Raymond Li"; upstream i3lock's has neither.
  if i3lock -v 2>&1 | grep -qE '[0-9]\.c\.[0-9]|Raymond Li'; then
    local RICE_I3LOCK_COLORS=()
    # shellcheck source=/dev/null
    [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/i3/lock.sh ]] && . "${XDG_CONFIG_HOME:-$HOME/.config}/i3/lock.sh"
    args+=(--indicator --clock --radius 110 --ring-width 6
      --time-str '%H:%M' --date-str '%A, %d %B'
      --time-font 'IBM Plex Sans' --date-font 'IBM Plex Sans' --verif-font 'IBM Plex Sans'
      --wrong-font 'IBM Plex Sans' --time-size 34 --date-size 14
      --verif-text 'checking' --wrong-text 'wrong password' --noinput-text 'no input'
      "${RICE_I3LOCK_COLORS[@]}")
    [[ -r $image ]] && args+=(-i "$image" -F)
  else
    [[ -r $image ]] && args+=(-i "$image" -t)
  fi
  exec i3lock "${args[@]}"
}

# The X11 session from LightDM: environment (~/.config/i3/env.sh, as env.lua under Hyprland),
# then i3 under its own session bus unless the display manager started one.
i3_session() {
  local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/i3/env.sh"
  # shellcheck source=/dev/null
  [[ -r $env_file ]] && . "$env_file"
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    exec i3
  fi
  exec dbus-run-session i3
}

# Long-running helpers of the i3 session, each started once (i3 restarts in place keep them):
# compositor, notifications, polkit agent, clipboard history, keyring, idle lock.
x11_helpers() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
  # The session bus learns the display, so D-Bus-activated programs (portals, keyring prompts)
  # open their windows on it.
  if command -v dbus-update-activation-environment >/dev/null; then
    dbus-update-activation-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP 2>/dev/null || true
  fi
  if ! running picom; then
    detach picom --config "$cfg/picom/picom.conf"
    # No working OpenGL (a VM, a missing Mesa driver): picom exits; xrender draws without blur.
    sleep 1
    running picom || detach picom --config "$cfg/picom/picom.conf" --backend xrender
  fi
  running dunst || detach dunst
  local agent
  for agent in /usr/local/libexec/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do
    if [[ -x $agent ]]; then
      pgrep -u "$(id -u)" -f polkit-gnome-authentication-agent-1 >/dev/null ||
        detach "$agent"
      break
    fi
  done
  # clipmenud is a bash script: match its command line, not the process name.
  pgrep -u "$(id -u)" -f clipmenud >/dev/null || { command -v clipmenud >/dev/null && detach clipmenud; }
  # Idle: the same timings as hypridle.conf: lock after 10 minutes, screens off a minute later.
  # xss-lock runs the locker when the X screensaver activates (xset s) and before suspend
  # where logind tells it (not on FreeBSD).
  xset s 600 600 2>/dev/null || true
  xset dpms 0 0 660 2>/dev/null || true
  running xss-lock || detach xss-lock -- "$0" lock
  return 0
}

case ${1:-} in
  start) start_polkit_agent; start_pipewire ;;
  lock) lock ;;
  power) power "${2:-}" ;;
  hyprland) hyprland ;;
  i3) i3_session ;;
  x11) x11_helpers ;;
  *) echo "usage: rice-session {start|lock|power suspend|reboot|poweroff|hyprland|i3|x11}" >&2; exit 2 ;;
esac
