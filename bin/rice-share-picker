#!/usr/bin/env bash
# rice-share-picker: the screen-share picker, in the Flight Deck rofi theme. Run by
# xdg-desktop-portal-hyprland (XDPH) when an app asks to share the screen; set in
# ~/.config/hypr/xdph.conf as screencopy:custom_picker_binary. Not meant to be run by hand.
#
# Protocol (XDPH src/shared/ScreencopyShared.cpp, the same from 1.3.11 to 1.5.0):
#   in   XDPH_WINDOW_SHARING_LIST  "HANDLE[HC>]CLASS[HT>]TITLE[HE>]ADDRESS[HA>]" per window
#        --allow-token             screencopy:allow_token_by_default is on
#   out  [SELECTION]FLAGS/screen:OUTPUT
#        [SELECTION]FLAGS/window:HANDLE
#        [SELECTION]FLAGS/region:OUTPUT@X,Y,W,H   (logical px, relative to the output)
#        FLAGS: "r" lets the app keep a restore token (reconnect later without asking).
#   Nothing printed = cancelled.
#
# Keys: Enter shares; Alt+Enter shares and allows the restore token. Runtime deps (official
# repos): rofi, jq, slurp, hyprctl.
set -Eeuo pipefail

allow_token=0
[[ "${1:-}" == --allow-token ]] && allow_token=1

entries=()   # what rofi shows
picks=()     # what each entry selects

# Outputs: Hyprland's connector names are the wl_output names XDPH matches on.
add_screens() {
    local name desc
    while IFS=$'\t' read -r name desc; do
        entries+=("󰍹  screen   ${name}  ${desc}")
        picks+=("screen:${name}")
    done < <(hyprctl -j monitors | jq -r '.[] | "\(.name)\t\(.width)x\(.height)  \(.description)"')
}

# Windows from XDPH's list. Its titles may hold any character but ' " $ ` (replaced by XDPH);
# newlines and tabs are flattened here so one window stays one row.
add_windows() {
    local list="${XDPH_WINDOW_SHARING_LIST:-}" entry handle rest class title
    while [[ "${list}" == *'[HA>]'* ]]; do
        entry="${list%%'[HA>]'*}"
        list="${list#*'[HA>]'}"
        [[ "${entry}" == *'[HC>]'*'[HT>]'*'[HE>]'* ]] || continue
        handle="${entry%%'[HC>]'*}"
        rest="${entry#*'[HC>]'}"
        class="${rest%%'[HT>]'*}"
        rest="${rest#*'[HT>]'}"
        title="${rest%%'[HE>]'*}"
        [[ "${handle}" =~ ^[0-9]+$ ]] || continue
        title="${title//[$'\n\t\r']/ }"
        entries+=("$(printf '  window   %-18.18s %s' "${class:-?}" "${title}")")
        picks+=("window:${handle}")
    done
}

# Region: slurp's %X/%Y are relative to the output holding the top-left corner, %W/%H clipped
# to it (slurp >= 1.4.0); the same format XDPH's own picker asks for.
pick_region() {
    local out x y w h
    read -r out x y w h < <(slurp -f '%o %X %Y %W %H') || return 1
    [[ -n "${out}" && "${x}" =~ ^[0-9]+$ && "${y}" =~ ^[0-9]+$ && "${w}" =~ ^[1-9][0-9]*$ && "${h}" =~ ^[1-9][0-9]*$ ]] || return 1
    printf 'region:%s@%s,%s,%s,%s' "${out}" "${x}" "${y}" "${w}" "${h}"
}

main() {
    add_screens
    add_windows
    entries+=("󰩭  region   select an area…")
    picks+=("region")

    local index rc=0 choice flags=""
    index="$(printf '%s\n' "${entries[@]}" |
        rofi -dmenu -i -no-custom -format i -p share -theme deck \
            -mesg "enter shares · alt+enter shares and lets the app reconnect without asking" \
            -kb-custom-1 Alt+Return)" || rc=$?
    case "${rc}" in
        0) ;;
        10) allow_token=1 ;;
        *) exit 0 ;;
    esac
    [[ "${index}" =~ ^[0-9]+$ ]] && (( index < ${#picks[@]} )) || exit 0

    choice="${picks[index]}"
    if [[ "${choice}" == region ]]; then
        choice="$(pick_region)" || exit 0
    fi
    (( allow_token )) && flags=r
    printf '[SELECTION]%s/%s\n' "${flags}" "${choice}"
}

main "$@"
